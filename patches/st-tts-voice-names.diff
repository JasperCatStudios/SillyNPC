+// SillyNPC fork patch: lets another extension add names to the voice map and queue speech
+// without going through /speak, which clears the queue on every call.
+/** @type {string[]} */
+let extraVoiceNames = [];
+
+/**
+ * Sets the extra names that get a voice-map entry beside the chat's own characters.
+ * @param {string[]} names
+ * @returns {Promise<void>} Resolves once the voice map has been rebuilt.
+ */
+export async function registerVoiceNames(names) {
+    const next = [...new Set((names || []).map(n => String(n || '').trim()).filter(Boolean))];
+    if (next.length === extraVoiceNames.length && next.every((n, i) => n === extraVoiceNames[i])) {
+        return;
+    }
+    extraVoiceNames = next;
+    if (!extension_settings.tts.enabled) return;
+    // Wait out a rebuild already under way: it started without these names.
+    if (currentInitVoiceMapPromise) {
+        try { await currentInitVoiceMapPromise; } catch { /* reported by its owner */ }
+    }
+    await initVoiceMap();
+}
+
+/**
+ * Queues text to be read in the voice mapped to a name, after whatever is already playing.
+ * @param {string} name A voice-map name, or '[Default Voice]'.
+ * @param {string} text
+ * @returns {boolean} Whether it was queued.
+ */
+export function speakAs(name, text) {
+    if (!extension_settings.tts.enabled || !String(text ?? '').trim()) return false;
+    processAndQueueTtsMessage({ mes: String(text), name: String(name) }, null, { manual: true });
+    moduleWorker();
+    return true;
+}
+
+/**
+ * The voices the active provider offers, by name.
+ * @returns {Promise<string[]>}
+ */
+export async function listVoices() {
+    try {
+        await ttsProvider.checkReady();
+        const voices = await ttsProvider.fetchTtsVoiceObjects();
+        return voices.map(v => v.name);
+    } catch {
+        return [];
+    }
+}
+
+/**
+ * The voice currently mapped to a name, or '' if none.
+ * @param {string} name
+ * @returns {string}
+ */
+export function getVoiceFor(name) {
+    const entry = voiceMapEntries.find(e => e.name === name);
+    if (entry) return entry.voiceId || '';
+    const saved = extension_settings.tts?.[ttsProviderName]?.voiceMap;
+    return (saved && typeof saved === 'object' && saved[name]) || '';
+}
+
+/**
+ * Maps a name to a voice, exactly as choosing it in the voice map would.
+ * @param {string} name
+ * @param {string} voiceName A voice from listVoices(), '[Default Voice]' or 'disabled'.
+ * @returns {boolean} False when the name has no row (call registerVoiceNames first).
+ */
+export function setVoiceFor(name, voiceName) {
+    const entry = voiceMapEntries.find(e => e.name === name);
+    if (!entry) return false;
+    entry.voiceId = voiceName;
+    entry.selectElement?.val(voiceName);
+    updateVoiceMap();
+    return true;
+}
+
+/** Stops whatever is being read and empties the queue. */
+export function stopSpeaking() {
+    resetTtsPlayback();
+}
